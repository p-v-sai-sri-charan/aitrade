# ─────────────────────────────────────────────────────────────────────────
# VaaniTrade environment configuration
# Copy this file to `.env` at the repo root (used by docker-compose) and/or
# `apps/api/.env` (used when running the API without Docker).
# NEVER commit a real .env file. NEVER put secrets in apps/web.
# ─────────────────────────────────────────────────────────────────────────

# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=info

# ---- Database ----
POSTGRES_USER=vaanitrade
POSTGRES_PASSWORD=vaanitrade_dev_password
POSTGRES_DB=vaanitrade
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://vaanitrade:vaanitrade_dev_password@localhost:5432/vaanitrade

# ---- Redis (redis-ready architecture; used for rate limiting / caching hooks) ----
REDIS_URL=redis://localhost:6379/0

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI provider selection ----
# One of: mock | anthropic | openai | gemini | local | ollama
# "mock" is a deterministic rule-based parser that needs NO API key and is
# the default so the project runs fully offline out of the box.
AI_PROVIDER=mock

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local OpenAI-compatible server (e.g. vLLM, LM Studio, text-generation-webui)
LOCAL_AI_BASE_URL=http://localhost:8080/v1
LOCAL_AI_MODEL=local-model
LOCAL_AI_API_KEY=not-needed

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Market data ----
# "mock" = seeded/jittered ~20-stock offline price list (default, no network).
# "yahoo" = live-ish prices for any NSE symbol via Yahoo Finance's public
# chart endpoint (no API key, but not a licensed feed -- see
# packages/broker-core/broker_core/market_data_live.py). Swap for a licensed
# vendor in production.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_CACHE_TTL_SECONDS=5

# ---- Instrument universe ----
# "seeded" = small curated ~20-stock list (default, no network).
# "nse" = auto-fetches the full NSE-listed equity universe from NSE's public
# equity list CSV, cached in memory and refreshed on this interval. Falls
# back to the seeded list if the fetch fails (see
# packages/broker-core/broker_core/instrument_repository_live.py).
INSTRUMENT_SOURCE=seeded
INSTRUMENT_CACHE_TTL_SECONDS=86400

# ---- Risk engine defaults (can be overridden per-user via /api/v1/settings) ----
RISK_MAX_ORDER_VALUE=200000
RISK_MAX_QUANTITY=5000
RISK_MAX_PRICE_DEVIATION_PCT=5
RISK_DAILY_LOSS_LIMIT=25000
RISK_DUPLICATE_ORDER_WINDOW_SECONDS=10
TRADING_KILL_SWITCH=false

# ---- Paper broker ----
PAPER_STARTING_BALANCE=1000000
PAPER_SLIPPAGE_BPS=5
PAPER_BROKERAGE_FLAT=20
PAPER_STT_RATE_SELL=0.00025
PAPER_GST_RATE=0.18

# ---- Frontend (Vite exposes only VITE_ prefixed vars, never secrets) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_APP_NAME=VaaniTrade
